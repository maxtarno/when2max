{
  "manifest_version": 3,
  "name": "when2max",
  "version": "0.1.0",
  "description": "Autofill your when2meet availability from Google Calendar.",
  "key": "",
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://www.googleapis.com/*", "https://oauth2.googleapis.com/*"],
  "oauth2": {
    "client_id": "302901805514-el0trdee2uml13j30gm3p67ajkmhiotp.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar.readonly"]
  },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "when2max settings" },
  "options_ui": { "page": "src/options/index.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["https://www.when2meet.com/*", "https://when2meet.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.when2meet.com/*", "https://when2meet.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
